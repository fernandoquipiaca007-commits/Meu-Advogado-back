# LegaWork Backend — Environment Variables
# Copy this file to .env or set these variables in your deployment environment.
# NEVER commit actual values to version control.

# ── Stripe Payment Collection ──────────────────────────────────────────────
# Required when financials.stripe_enabled = true
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/legawork
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_minimum_256_bits
JWT_EXPIRATION_MS=86400000

# ── Application URLs ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# ── Email (SMTP) ────────────────────────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# ── Feature Flags (override defaults if needed) ──────────────────────────────
# legawork.features.financials.stripe-enabled=false
# legawork.features.payouts.paypal-enabled=false
# legawork.features.funds.hold-enabled=false
# legawork.features.automation.auto-release-enabled=false
# legawork.features.auth.cookie-session-enabled=false
